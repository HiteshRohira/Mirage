+/* The synthetic localhost master endpoint accepts optional query parameters.
+ * Keep complete media request URLs for signed/query-selected playlist lookup. */
+bool is_hls_master_request(const char *url) {
+    const char master[] = "/master.m3u8";
+    size_t len = sizeof(master) - 1;
+    return url && !strncmp(url, master, len) && (url[len] == '\0' || url[len] == '?');
